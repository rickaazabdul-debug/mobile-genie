rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can submit a repair booking; authenticated users can read their own bookings.
    match /repair_bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'email', 'deviceModel', 'serviceType', 'createdAt'])
                    && request.resource.data.customerName is string
                    && request.resource.data.email is string;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Authenticated users can create and read their own store orders.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
