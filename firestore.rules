rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['rickaazabdul@gmail.com', 'acmrickaaz@gmail.com'];
    }

    // Anyone can submit a repair booking, look up a single ticket by ticketCode, or reschedule/cancel it.
    match /repair_bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'email', 'deviceModel', 'serviceType', 'createdAt'])
                    && request.resource.data.customerName is string
                    && request.resource.data.email is string;
      allow get: if true;
      allow list: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid)
                  || (request.query.limit <= 1);
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['preferredDate', 'timeSlot', 'status', 'rescheduledAt', 'reminderEnabled']);
      allow delete: if isAdmin();
    }

    // Authenticated users can create and read their own store orders; admins can manage all.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
